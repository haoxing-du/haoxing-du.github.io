html,body,div,span,applet,object,iframe,h1,h2,h3,h4,h5,h6,p,blockquote,pre,a,abbr,acronym,address,big,cite,code,del,dfn,em,img,ins,kbd,q,s,samp,small,strike,strong,sub,sup,tt,var,b,u,i,center,dl,dt,dd,ol,ul,li,fieldset,form,label,legend,table,caption,tbody,tfoot,thead,tr,th,td,article,aside,canvas,details,embed,figure,figcaption,footer,header,hgroup,menu,nav,output,ruby,section,summary,time,mark,audio,video{margin:0;padding:0;border:0;font-size:100%;font:inherit;vertical-align:baseline}article,aside,details,figcaption,figure,footer,header,hgroup,menu,nav,section{display:block}body{line-height:1}ol,ul{list-style:none}blockquote,q{quotes:none}blockquote:before,blockquote:after,q:before,q:after{content:'';content:none}table{border-collapse:collapse;border-spacing:0}html{box-sizing:border-box}*,*:before,*:after{box-sizing:inherit}html{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}::selection{background:#ece8ef;color:#241f29}body{font-family:"Source Serif 4","Klee One",Georgia,Cambria,"Times New Roman",Times,serif;color:#241f29;font-size:1.0625rem;line-height:1.6;background:#fff;font-optical-sizing:auto;overflow-wrap:break-word}p{margin:1em 0}em,i{font-style:italic}strong,b{font-weight:bold}h1,h2,h3,h4,h5,h6{font-family:"Source Serif 4","Klee One",Georgia,Cambria,"Times New Roman",Times,serif;font-weight:700;letter-spacing:-0.005em;margin:1.8em 0 0.8em 0;line-height:1.2;text-wrap:balance;color:#241f29}h1{font-size:1.625rem}h2{font-size:1.375rem}h3{font-size:1.125rem}h4{font-size:1.0625rem}h5{font-size:.875rem}h6{font-size:.875rem;font-weight:600}h4,h5,h6{text-transform:uppercase;letter-spacing:0.05em;margin-top:2.5em}a{color:#6e5a78;text-decoration-line:underline;text-decoration-color:transparent;text-underline-position:from-font;text-decoration-thickness:from-font;text-underline-offset:0.15em;text-decoration-skip-ink:auto;transition:color 0.15s ease, text-decoration-color 0.15s ease}a:hover{color:#584860;text-decoration-color:currentColor}a:focus-visible{outline:2px solid #6e5a78;outline-offset:3px}article.content a,main>p:not(.horizontal-links) a,section a{text-decoration-color:currentColor}ol li{list-style:decimal;margin-left:1.25em;margin-bottom:0.2em}ul li{list-style:disc;margin-left:1.25em;margin-bottom:0.2em}dt{font-weight:bold}dd{margin-left:1.25em}hr{margin:2.5em auto;border:0;width:6em;text-align:center}hr:after{content:"* * *";letter-spacing:0.6em;color:#666}pre,code{font-family:SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace;border-radius:3px}code{background:#f9f9f9;font-size:.875rem;padding:0.25em 0.5em;color:#241f29}pre code{background:#f9f9f9;display:block;margin:1em 0;padding:0.75em 1em;color:inherit}img,video{max-width:100%;height:auto;border-radius:3px}figure{width:100%;margin:2em 0;text-align:center}figcaption{text-align:center;font-size:.875rem;color:#666}figcaption p{margin:0}blockquote{padding-left:1.25em;padding-right:1.5em;border-left:0.25em solid #ece8ef;color:#666}table{margin-bottom:1em;width:100%;border:1px solid #ece8ef}td,th{vertical-align:middle;padding:.25rem .5rem;border:1px solid #ece8ef}th{font-weight:bold}tbody tr:nth-child(2n+1) td,tbody tr:nth-child(2n+1) th{background-color:#f9f9f9}sup,sub{font-size:0.8em}sup{vertical-align:super}main{max-width:calc(70ch + 40px);padding:0 20px;margin:0 auto}header h2{font-family:"Source Serif 4","Klee One",Georgia,Cambria,"Times New Roman",Times,serif;font-weight:600;font-size:1.125rem;margin:2em 1em 1.5em}header h2 a{text-decoration:none;border:none;color:#6e5a78}header h2 a:hover{color:#584860}.combined-title-pagination{margin-top:2.5em}.combined-title-pagination h1{display:inline}.combined-title-pagination h1 a{text-decoration:none;border:none}.combined-title-pagination h3{display:inline;margin-left:0.2em}.title-group{margin-bottom:2em}.title-group .title h1{margin-bottom:0.4em;font-size:2rem;letter-spacing:-0.015em}.title-group .date h5{color:#666;margin:0;font-family:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol"}footer{margin-top:4em;font-size:.875rem;color:#666}footer .content-container{background:transparent;border-top:1px solid #ece8ef;padding:2em 0 3em}footer .content-container .content{max-width:calc(70ch + 40px);font-size:1.0625rem;padding:0 20px;margin:0 auto}.horizontal-links{width:100%;margin-top:0;margin-bottom:0.25em;font-family:"Source Serif 4","Klee One",Georgia,Cambria,"Times New Roman",Times,serif}.horizontal-links a{white-space:nowrap;padding-right:0.4em;margin-right:0.9em;border-bottom:none}.horizontal-links a:hover{text-decoration:underline}.horizontal-links a:last-child{margin-right:0}.horizontal-links:last-child{margin-bottom:1.25em}.post-list{padding-bottom:1.5em;border-bottom:1px solid #ece8ef}.post-list h1 a{color:#6e5a78;text-decoration:none;border:none}.post-list h1 a:hover{color:#584860}.post-list .read-more{margin-bottom:1.25em}.about-photo{display:block;width:140px;height:140px;object-fit:cover;border-radius:50%;margin:0 0 1.5em}.post-index{list-style:none;padding:0;margin:0 0 2em}.post-index li{list-style:none;margin:0;padding:0.5em 0;border-bottom:1px solid #ece8ef;display:flex;justify-content:space-between;align-items:baseline;gap:1em}.post-index li:last-child{border-bottom:none}.post-index a{border-bottom:none}.post-index a:hover{color:#584860}.post-index .date{color:#666;font-size:.875rem;font-variant-numeric:tabular-nums;white-space:nowrap}.tags{font-size:.875rem}.tags .links{display:inline;margin-left:0.5em}.tags .links a{color:#6e5a78;text-decoration:none;border-bottom:none}.tags .links a:hover{color:#584860;text-decoration:underline}.paginator{margin:2em 0}.paginator .disabled{color:#666}.paginator .newer{float:right;clear:both}.current-page{color:#666}.album .date,.album .date h5,.album .location,.album .location h5{display:inline}.album .location{color:#666;border-left:solid 2px #ece8ef;padding-left:1em;margin-left:1em}.album .photos{display:grid;grid-template-columns:repeat(2, 1fr);gap:0.7em 0.7em}.album .photos a{display:grid}.album .photos a.full-size{grid-column-start:1;grid-column-end:3}@media (max-width: 400px){.album .photos{grid-template-columns:1fr}.album .photos a{grid-column-start:1;grid-column-end:3}}code.has-jax{background:inherit !important;border:none !important;font-size:100%}.last-updated{color:#666;font-family:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol";font-size:.875rem;font-variant-numeric:tabular-nums}.post-list p{text-wrap:pretty}pre{overflow-x:auto}@media (max-width: 600px){.title-group .title h1{font-size:1.625rem;line-height:1.4}.post-index li{flex-wrap:wrap;gap:0.15em 1em}.post-index a{min-width:0}.post-index .date{flex-basis:100%}}

/*# sourceMappingURL=rocinante.css.map */